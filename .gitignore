build*/
dist/
build_vanilla/
iso_build/
verify_extract/
verify_extract2/
tools_ext/
*.iso
.ninja_deps
.ninja_log
build.ninja
compile_commands.json
objdiff.json

# Original (retail-extracted) files -- never commit copyrighted game data.
orig/*/*
!orig/*/sys
orig/*/sys/*
!orig/*/sys/.gitkeep
*.inc
__pycache__/
.zsign_cache/

# Internal working notes stay local; only the screenshots are published.
docs/*
!docs/screenshots/
!docs/CODING_STYLE.md
!docs/tag_assist_roster.csv
!docs/architecture.md
!docs/building.md
!docs/debugging.md
!docs/porting-notes.md
!docs/testing.md
!docs/site/

# Claude working notes stay local -- never commit these.
CLAUDE.md

# Android build outputs (CI builds these from source).
platforms/android/.gradle/
platforms/android/.idea/
platforms/android/local.properties
platforms/android/*/build/
platforms/android/app/libs/
platforms/android/app/src/main/jniLibs/
platforms/android/app/src/main/assets/

# Release signing material stays local; CI reads it from repository secrets.
platforms/android/melee-release.keystore
platforms/android/release-signing.env

# Proton/wine leavings from tools/run_proton.sh.
vkd3d-proton.cache*
steam_appid.txt

# MELEE_LOG_FILE defaults to this beside the executable on Windows, so a run
# started from the repo root writes it here.
melee-pc.log
